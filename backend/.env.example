# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecosphere?schema=public"

# JWT secrets
JWT_ACCESS_SECRET="your_jwt_access_secret_key_here_minimum_8_chars"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here_minimum_8_chars"

# JWT token durations
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
