datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------
// Role Model
// --------------------------------------------------
model Role {
  id              String    @id @default(uuid())
  name            String    @unique
  code            String    @unique // e.g. ADMIN, ESG_MANAGER, DEPARTMENT_HEAD, EMPLOYEE
  description     String?

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("RoleCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("RoleUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("RoleDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  users           User[]

  @@index([code])
}

// --------------------------------------------------
// User Model
// --------------------------------------------------
model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  isActive        Boolean   @default(true)

  // BaseModel Audits (Self-Referencing)
  createdByUserId String?
  createdByUser   User?     @relation("UserCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("UserUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("UserDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Inverse Self Relations
  createdUsers    User[]    @relation("UserCreatedBy")
  updatedUsers    User[]    @relation("UserUpdatedBy")
  deletedUsers    User[]    @relation("UserDeletedBy")

  // HR Employee Relation (1-to-1)
  employee        Employee? @relation("EmployeeUser")

  // Inverse Audit Relations
  createdRoles         Role[]         @relation("RoleCreatedBy")
  updatedRoles         Role[]         @relation("RoleUpdatedBy")
  deletedRoles         Role[]         @relation("RoleDeletedBy")
  
  createdDepartments   Department[]   @relation("DepartmentCreatedBy")
  updatedDepartments   Department[]   @relation("DepartmentUpdatedBy")
  deletedDepartments   Department[]   @relation("DepartmentDeletedBy")
  
  createdCategories    Category[]     @relation("CategoryCreatedBy")
  updatedCategories    Category[]     @relation("CategoryUpdatedBy")
  deletedCategories    Category[]     @relation("CategoryDeletedBy")
  
  createdEmployees     Employee[]     @relation("EmployeeCreatedBy")
  updatedEmployees     Employee[]     @relation("EmployeeUpdatedBy")
  deletedEmployees     Employee[]     @relation("EmployeeDeletedBy")
  
  createdSettings      Setting[]      @relation("SettingCreatedBy")
  updatedSettings      Setting[]      @relation("SettingUpdatedBy")
  deletedSettings      Setting[]      @relation("SettingDeletedBy")

  createdNotifications Notification[] @relation("NotificationCreatedBy")
  updatedNotifications Notification[] @relation("NotificationUpdatedBy")
  deletedNotifications Notification[] @relation("NotificationDeletedBy")

  createdEmissionFactors     EmissionFactor[]     @relation("EmissionFactorCreatedBy")
  updatedEmissionFactors     EmissionFactor[]     @relation("EmissionFactorUpdatedBy")
  deletedEmissionFactors     EmissionFactor[]     @relation("EmissionFactorDeletedBy")

  createdCarbonTransactions  CarbonTransaction[]  @relation("CarbonTransactionCreatedBy")
  updatedCarbonTransactions  CarbonTransaction[]  @relation("CarbonTransactionUpdatedBy")
  deletedCarbonTransactions  CarbonTransaction[]  @relation("CarbonTransactionDeletedBy")

  createdEnvironmentalGoals  EnvironmentalGoal[]  @relation("EnvironmentalGoalCreatedBy")
  updatedEnvironmentalGoals  EnvironmentalGoal[]  @relation("EnvironmentalGoalUpdatedBy")
  deletedEnvironmentalGoals  EnvironmentalGoal[]  @relation("EnvironmentalGoalDeletedBy")

  createdESGPolicies         ESGPolicy[]          @relation("ESGPolicyCreatedBy")
  updatedESGPolicies         ESGPolicy[]          @relation("ESGPolicyUpdatedBy")
  deletedESGPolicies         ESGPolicy[]          @relation("ESGPolicyDeletedBy")

  createdPolicyAcknowledgements PolicyAcknowledgement[] @relation("PolicyAcknowledgementCreatedBy")
  updatedPolicyAcknowledgements PolicyAcknowledgement[] @relation("PolicyAcknowledgementUpdatedBy")
  deletedPolicyAcknowledgements PolicyAcknowledgement[] @relation("PolicyAcknowledgementDeletedBy")

  createdAudits              Audit[]              @relation("AuditCreatedBy")
  updatedAudits              Audit[]              @relation("AuditUpdatedBy")
  deletedAudits              Audit[]              @relation("AuditDeletedBy")

  createdAuditChecklists     AuditChecklist[]     @relation("AuditChecklistCreatedBy")
  updatedAuditChecklists     AuditChecklist[]     @relation("AuditChecklistUpdatedBy")
  deletedAuditChecklists     AuditChecklist[]     @relation("AuditChecklistDeletedBy")

  createdComplianceIssues    ComplianceIssue[]    @relation("ComplianceIssueCreatedBy")
  updatedComplianceIssues    ComplianceIssue[]    @relation("ComplianceIssueUpdatedBy")
  deletedComplianceIssues    ComplianceIssue[]    @relation("ComplianceIssueDeletedBy")

  createdCSRActivities        CSRActivity[]        @relation("CSRActivityCreatedBy")
  updatedCSRActivities        CSRActivity[]        @relation("CSRActivityUpdatedBy")
  deletedCSRActivities        CSRActivity[]        @relation("CSRActivityDeletedBy")

  createdVolunteerParticipations VolunteerParticipation[] @relation("VolunteerParticipationCreatedBy")
  updatedVolunteerParticipations VolunteerParticipation[] @relation("VolunteerParticipationUpdatedBy")
  deletedVolunteerParticipations VolunteerParticipation[] @relation("VolunteerParticipationDeletedBy")

  createdSocialGoals          SocialGoal[]          @relation("SocialGoalCreatedBy")
  updatedSocialGoals          SocialGoal[]          @relation("SocialGoalUpdatedBy")
  deletedSocialGoals          SocialGoal[]          @relation("SocialGoalDeletedBy")

  createdChallenges           Challenge[]           @relation("ChallengeCreatedBy")
  updatedChallenges           Challenge[]           @relation("ChallengeUpdatedBy")
  deletedChallenges           Challenge[]           @relation("ChallengeDeletedBy")

  createdChallengeParticipations ChallengeParticipation[] @relation("ChallengeParticipationCreatedBy")
  updatedChallengeParticipations ChallengeParticipation[] @relation("ChallengeParticipationUpdatedBy")
  deletedChallengeParticipations ChallengeParticipation[] @relation("ChallengeParticipationDeletedBy")

  createdBadges               Badge[]               @relation("BadgeCreatedBy")
  updatedBadges               Badge[]               @relation("BadgeUpdatedBy")
  deletedBadges               Badge[]               @relation("BadgeDeletedBy")

  createdEmployeeBadges       EmployeeBadge[]       @relation("EmployeeBadgeCreatedBy")
  updatedEmployeeBadges       EmployeeBadge[]       @relation("EmployeeBadgeUpdatedBy")
  deletedEmployeeBadges       EmployeeBadge[]       @relation("EmployeeBadgeDeletedBy")

  createdRewards              Reward[]              @relation("RewardCreatedBy")
  updatedRewards              Reward[]              @relation("RewardUpdatedBy")
  deletedRewards              Reward[]              @relation("RewardDeletedBy")

  createdRewardRedemptions    RewardRedemption[]    @relation("RewardRedemptionCreatedBy")
  updatedRewardRedemptions    RewardRedemption[]    @relation("RewardRedemptionUpdatedBy")
  deletedRewardRedemptions    RewardRedemption[]    @relation("RewardRedemptionDeletedBy")

  // Recipient Notifications
  notifications        Notification[] @relation("NotificationRecipient")

  // System Audit Activity Logs
  activityLogs         ActivityLog[]

  @@index([email])
}

// --------------------------------------------------
// Department Model
// --------------------------------------------------
model Department {
  id              String    @id @default(uuid())
  name            String    @unique
  code            String    @unique // e.g. HR, FIN, ESG, OPS

  // Manager Relation (Department Head)
  managerId       String?   @unique
  manager         Employee? @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)

  // Department Employees
  employees       Employee[] @relation("EmployeeDepartment")

  // Environmental Metrics and Relations
  carbonTransactions CarbonTransaction[]
  environmentalGoals EnvironmentalGoal[]
  audits             Audit[]
  socialGoals        SocialGoal[]

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("DepartmentCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("DepartmentUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("DepartmentDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([code])
}

// --------------------------------------------------
// Category Model (ESG Metircs Categories)
// --------------------------------------------------
model Category {
  id              String    @id @default(uuid())
  name            String    @unique
  code            String    @unique // e.g. EMISSIONS, WASTE, WATER, SOCIAL_RESP, GOV_POLICY
  description     String?

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("CategoryCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("CategoryUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("CategoryDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([code])
}

// --------------------------------------------------
// Employee Model
// --------------------------------------------------
model Employee {
  id              String      @id @default(uuid())
  firstName       String
  lastName        String
  employeeId      String      @unique // Employee Code e.g. EMP001
  email           String      @unique
  phone           String?

  // 1-to-1 User system access link
  userId          String?     @unique
  user            User?       @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)

  // Department Relation
  departmentId    String?
  department      Department? @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  // Managed Department Relation (Manager of Department)
  managedDepartment Department? @relation("DepartmentManager")

  // Gamification & Social Metrics
  xp              Int         @default(0)
  volunteerHours  Float       @default(0.0)

  // Governance Relations
  policyAcknowledgements PolicyAcknowledgement[]
  ownedComplianceIssues  ComplianceIssue[]

  // Social & Gamification Relations
  volunteerParticipations VolunteerParticipation[]
  challengeParticipations ChallengeParticipation[]
  employeeBadges          EmployeeBadge[]
  rewardRedemptions       RewardRedemption[]
  leaderboardRow          Leaderboard?

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?       @relation("EmployeeCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?       @relation("EmployeeUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?       @relation("EmployeeDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@index([employeeId])
  @@index([email])
}

// --------------------------------------------------
// ActivityLog Model (Audit Trail)
// --------------------------------------------------
model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?  // Performed by user
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // CREATE, UPDATE, DELETE
  entity      String   // Model Name: e.g. Department, User, Employee
  entityId    String   // Primary key of affected row
  oldValue    Json?    // Pre-state
  newValue    Json?    // Post-state
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
}

// --------------------------------------------------
// Notification Model (System Alerts / Messaging)
// --------------------------------------------------
model Notification {
  id              String    @id @default(uuid())
  userId          String    // Recipient User
  user            User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  title           String
  message         String
  type            String    @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  isRead          Boolean   @default(false)

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("NotificationCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("NotificationUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("NotificationDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([userId])
}

// --------------------------------------------------
// Setting Model (Key-Value configuration)
// --------------------------------------------------
model Setting {
  id              String    @id @default(uuid())
  key             String    @unique // AUTO_EMISSION_CALC, BADGE_AUTO_AWARD, EVIDENCE_REQUIREMENT
  value           String
  description     String?

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("SettingCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("SettingUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("SettingDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([key])
}

// --------------------------------------------------
// EmissionFactor Model
// --------------------------------------------------
model EmissionFactor {
  id              String    @id @default(uuid())
  name            String    @unique
  factor          Float
  unit            String    // e.g. kWh, kg, liter
  sourceType      String    // Electricity, Diesel, Petrol, Natural Gas, Water, Waste, Business Travel
  description     String?

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("EmissionFactorCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("EmissionFactorUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("EmissionFactorDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  carbonTransactions CarbonTransaction[]

  @@index([name])
  @@index([sourceType])
}

// --------------------------------------------------
// CarbonTransaction Model
// --------------------------------------------------
model CarbonTransaction {
  id               String    @id @default(uuid())
  departmentId     String
  department       Department @relation(fields: [departmentId], references: [id])
  emissionFactorId String
  emissionFactor   EmissionFactor @relation(fields: [emissionFactorId], references: [id])
  quantity         Float
  emissions        Float     // CO2 calculated = quantity * factor
  evidenceUrl      String?
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  transactionDate  DateTime  @default(now())
  description      String?

  // BaseModel Audits
  createdByUserId  String?
  createdByUser    User?     @relation("CarbonTransactionCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId  String?
  updatedByUser    User?     @relation("CarbonTransactionUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId  String?
  deletedByUser    User?     @relation("CarbonTransactionDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([departmentId])
  @@index([emissionFactorId])
  @@index([status])
  @@index([transactionDate])
}

// --------------------------------------------------
// EnvironmentalGoal Model
// --------------------------------------------------
model EnvironmentalGoal {
  id              String    @id @default(uuid())
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  targetEmissions Float
  year            Int
  status          String    @default("ACTIVE") // ACTIVE, ACHIEVED, EXCEEDED
  description     String?

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("EnvironmentalGoalCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("EnvironmentalGoalUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("EnvironmentalGoalDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([departmentId])
  @@index([year])
}

// --------------------------------------------------
// ESGPolicy Model
// --------------------------------------------------
model ESGPolicy {
  id              String    @id @default(uuid())
  title           String
  code            String    @unique // e.g. POL-001
  content         String
  effectiveDate   DateTime  @default(now())
  version         String    @default("1.0")
  status          String    @default("DRAFT") // DRAFT, ACTIVE, ARCHIVED

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("ESGPolicyCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("ESGPolicyUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("ESGPolicyDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  acknowledgements PolicyAcknowledgement[]

  @@index([code])
}

// --------------------------------------------------
// PolicyAcknowledgement Model
// --------------------------------------------------
model PolicyAcknowledgement {
  id              String    @id @default(uuid())
  policyId        String
  policy          ESGPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  acknowledgedAt  DateTime?
  status          String    @default("PENDING") // PENDING, ACKNOWLEDGED

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("PolicyAcknowledgementCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("PolicyAcknowledgementUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("PolicyAcknowledgementDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@unique([policyId, employeeId])
  @@index([policyId])
  @@index([employeeId])
  @@index([status])
}

// --------------------------------------------------
// Audit Model
// --------------------------------------------------
model Audit {
  id              String    @id @default(uuid())
  title           String
  code            String    @unique // e.g. AUD-001
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  auditorName     String
  auditDate       DateTime
  status          String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, CANCELLED
  score           Float?
  maxScore        Float?
  percentage      Float?
  findings        String?

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("AuditCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("AuditUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("AuditDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // Relations
  complianceIssues ComplianceIssue[]
  checklists       AuditChecklist[]

  @@index([code])
  @@index([departmentId])
}

// --------------------------------------------------
// AuditChecklist Model
// --------------------------------------------------
model AuditChecklist {
  id              String    @id @default(uuid())
  auditId         String
  audit           Audit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  title           String
  status          String    @default("PENDING") // PENDING, VERIFIED, FAILED
  remarks         String?
  verifiedBy      String?   // Employee name or identifier

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("AuditChecklistCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("AuditChecklistUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("AuditChecklistDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([auditId])
}

// --------------------------------------------------
// ComplianceIssue Model
// --------------------------------------------------
model ComplianceIssue {
  id              String    @id @default(uuid())
  auditId         String?
  audit           Audit?    @relation(fields: [auditId], references: [id], onDelete: SetNull)
  title           String
  description     String
  status          String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  severity        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  ownerId         String
  owner           Employee  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  dueDate         DateTime
  resolvedAt      DateTime?

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("ComplianceIssueCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("ComplianceIssueUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("ComplianceIssueDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([auditId])
  @@index([ownerId])
  @@index([status])
}

// ==================================================
// SOCIAL MODULE
// ==================================================

model CSRActivity {
  id                  String    @id @default(uuid())
  title               String
  description         String
  activityDate        DateTime
  volunteerHoursEarned Float     @default(0.0)
  status              String    @default("PLANNED") // PLANNED, ACTIVE, COMPLETED, CANCELLED
  maxParticipants     Int?

  // BaseModel Audits
  createdByUserId     String?
  createdByUser       User?     @relation("CSRActivityCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId     String?
  updatedByUser       User?     @relation("CSRActivityUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId     String?
  deletedByUser       User?     @relation("CSRActivityDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  // Relations
  participations      VolunteerParticipation[]

  @@index([status])
}

model VolunteerParticipation {
  id              String      @id @default(uuid())
  csrActivityId   String
  csrActivity     CSRActivity @relation(fields: [csrActivityId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status          String      @default("PENDING") // PENDING, APPROVED, REJECTED
  proofUrl        String?
  proofStatus     String      @default("PENDING") // PENDING, VERIFIED, REJECTED
  hoursEarned     Float       @default(0.0)
  acknowledgedAt  DateTime?

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?       @relation("VolunteerParticipationCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?       @relation("VolunteerParticipationUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?       @relation("VolunteerParticipationDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@unique([csrActivityId, employeeId])
  @@index([csrActivityId])
  @@index([employeeId])
  @@index([status])
}

model SocialGoal {
  id                   String      @id @default(uuid())
  title                String
  description          String?
  targetVolunteerHours Float
  year                 Int
  departmentId         String?
  department           Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status               String      @default("ACTIVE") // ACTIVE, ACHIEVED, EXCEEDED

  // BaseModel Audits
  createdByUserId      String?
  createdByUser        User?       @relation("SocialGoalCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId      String?
  updatedByUser        User?       @relation("SocialGoalUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId      String?
  deletedByUser        User?       @relation("SocialGoalDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  @@index([year])
  @@index([departmentId])
}

// ==================================================
// GAMIFICATION MODULE
// ==================================================

model Challenge {
  id                   String      @id @default(uuid())
  title                String
  description          String
  baseXp               Int         @default(0)
  difficultyMultiplier Float       @default(1.0)
  completionBonus      Int         @default(0)
  earlySubmissionBonus Int         @default(0)
  status               String      @default("DRAFT") // DRAFT, ACTIVE, UNDER_REVIEW, COMPLETED, ARCHIVED
  startDate            DateTime
  endDate              DateTime

  // BaseModel Audits
  createdByUserId      String?
  createdByUser        User?       @relation("ChallengeCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId      String?
  updatedByUser        User?       @relation("ChallengeUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId      String?
  deletedByUser        User?       @relation("ChallengeDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  // Relations
  participations       ChallengeParticipation[]

  @@index([status])
}

model ChallengeParticipation {
  id                String      @id @default(uuid())
  challengeId       String
  challenge         Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status            String      @default("JOINED") // JOINED, COMPLETED, FAILED
  proofUrl          String?
  completedAt       DateTime?
  isEarlySubmission Boolean     @default(false)

  // BaseModel Audits
  createdByUserId   String?
  createdByUser     User?       @relation("ChallengeParticipationCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId   String?
  updatedByUser     User?       @relation("ChallengeParticipationUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId   String?
  deletedByUser     User?       @relation("ChallengeParticipationDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  @@unique([challengeId, employeeId])
  @@index([challengeId])
  @@index([employeeId])
  @@index([status])
}

model Badge {
  id              String          @id @default(uuid())
  name            String          @unique
  description     String
  xpThreshold     Int
  iconUrl         String?

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?           @relation("BadgeCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?           @relation("BadgeUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?           @relation("BadgeDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  // Relations
  employeeBadges  EmployeeBadge[]

  @@index([xpThreshold])
}

model EmployeeBadge {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  badgeId         String
  badge           Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  unlockedAt      DateTime  @default(now())

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("EmployeeBadgeCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("EmployeeBadgeUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("EmployeeBadgeDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@unique([employeeId, badgeId])
  @@index([employeeId])
  @@index([badgeId])
}

model Reward {
  id              String             @id @default(uuid())
  title           String
  description     String
  xpCost          Int
  stock           Int                @default(0)

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?              @relation("RewardCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?              @relation("RewardUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?              @relation("RewardDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  // Relations
  redemptions     RewardRedemption[]
}

model RewardRedemption {
  id              String    @id @default(uuid())
  rewardId        String
  reward          Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  redeemedAt      DateTime  @default(now())
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, DELIVERED

  // BaseModel Audits
  createdByUserId String?
  createdByUser   User?     @relation("RewardRedemptionCreatedBy", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedByUser   User?     @relation("RewardRedemptionUpdatedBy", fields: [updatedByUserId], references: [id])
  deletedByUserId String?
  deletedByUser   User?     @relation("RewardRedemptionDeletedBy", fields: [deletedByUserId], references: [id])

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([rewardId])
  @@index([employeeId])
  @@index([status])
}

model Leaderboard {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  xp         Int      @default(0)
  rank       Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@index([xp])
}

